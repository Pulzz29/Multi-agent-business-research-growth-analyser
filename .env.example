# InsightIQ local configuration
# Copy to .env and fill in. Never commit .env to Git.

# ---- Application authentication ----
# Bearer key the dashboard uses to call the API (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
API_ACCESS_KEY=

# ---- LLM: Azure OpenAI (all AI research writing) ----
# Microsoft Foundry -> your Azure OpenAI resource -> "Keys and Endpoint":
#   AZURE_OPENAI_API_KEY   = KEY 1 (or KEY 2)
#   AZURE_OPENAI_ENDPOINT  = the resource endpoint, e.g. https://<resource>.openai.azure.com/
#                            (with or without the /openai/v1 suffix; no api-version query string)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# The model: Microsoft Foundry -> Deployments -> the deployment NAME.
LLM_MODEL=gpt-4o  # change this to switch models, then restart the backend
# (AZURE_OPENAI_DEPLOYMENT is still accepted as the older name; LLM_MODEL wins.)

# Optional LLM settings (blank or commented out: the defaults shown).
# LLM_TEMPERATURE=0.2            # not sent when a reasoning effort is set; dropped if the model rejects it
# LLM_REASONING_EFFORT=          # reasoning models only: none | minimal | low | medium | high | xhigh
# LLM_MAX_OUTPUT_TOKENS=         # cap on every call (blank: per-call caps below, adapted to the model's limit)
# LLM_TIMEOUT_SECONDS=180        # per HTTP request
# LLM_MAX_RETRIES=3              # 429 / 5xx / timeouts, exponential backoff
# LLM_API=auto                   # auto | chat | responses (auto switches Responses-only models)
# LLM_EXPECTED_MODEL_PREFIX=     # defaults to LLM_MODEL; set when the deployment name differs from the model

# ---- Groq (optional fallback for Azure OpenAI) ----
# Used only when Azure fails because its key is missing or rejected (401/403) or
# the model/deployment is not found (404). Outages, rate limits and answers that
# fail InsightIQ's checks never fall back. Key: https://console.groq.com -> API Keys.
# GROQ_MODEL is required when GROQ_API_KEY is set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Free-tier per-minute token limits are small: larger evidence profiles are skipped.
# INSIGHTIQ_GROQ_INPUT_TOKEN_BUDGET=6000
# INSIGHTIQ_GROQ_MAX_OUTPUT_TOKENS=8000

# ---- NewsData.io (genuine company-specific news) ----
NEWSDATA_API_KEY=

# ---- SEC EDGAR (genuine financial filings) ----
# Application name and a real contact email, as SEC requires, e.g. "InsightIQ research you@example.com"
SEC_USER_AGENT=

# ---- Market data providers ----
# US market: Finnhub (quotes, metrics, company news) and Financial Modeling Prep
# (company profile, financial statements). Indian market: Yahoo Finance via
# yfinance (no key) plus NewsData.io above. Keys stay on the backend only.
FINNHUB_API_KEY=
FMP_API_KEY=

# ---- Application settings ----
# INSIGHTIQ_API_PORT=8000
# INSIGHTIQ_PROJECT_ROOT is set automatically by scripts/run_backend.py

# ---- LLM request limits (optional) ----
# Upper bound on the estimated input tokens of one request (evidence is trimmed to fit).
# INSIGHTIQ_AZURE_INPUT_TOKEN_BUDGET=24000
# Output caps per call. Reasoning tokens count toward these caps; they are limits,
# not targets (billing is per token actually used).
# INSIGHTIQ_AZURE_MAX_OUTPUT_TOKENS_FINANCIAL=20000
# INSIGHTIQ_AZURE_MAX_OUTPUT_TOKENS_NEWS_SELECTION=8000
# INSIGHTIQ_AZURE_MAX_OUTPUT_TOKENS_NEWS_ANALYSIS=16000
# INSIGHTIQ_AZURE_MAX_OUTPUT_TOKENS_STRATEGIC=20000
# INSIGHTIQ_AZURE_MAX_OUTPUT_TOKENS_SUMMARY=16000
# INSIGHTIQ_AZURE_MAX_OUTPUT_TOKENS_RESEARCH_BRIEF=32000   # AI summary + thorough research on a report
# INSIGHTIQ_AZURE_MAX_OUTPUT_TOKENS_SECTOR=20000
# A single AI call (all attempts) stops after this many seconds.
# INSIGHTIQ_AZURE_CALL_DEADLINE_SECONDS=900
# INSIGHTIQ_AZURE_POLL_INTERVAL_SECONDS=3   # Responses API background polling
# INSIGHTIQ_AZURE_MAX_CONCURRENT_CALLS=2
# A research job running longer than this is stopped and marked failed.
# INSIGHTIQ_RESEARCH_JOB_DEADLINE_SECONDS=3600

# ---- Source freshness and refresh policy ----
# Stored evidence older than these limits is "stale". Start Research refreshes
# stale sources first unless disabled (the dashboard can also skip per run).
# INSIGHTIQ_SEC_CACHE_HOURS=24
# INSIGHTIQ_NEWS_CACHE_HOURS=6
# INSIGHTIQ_AUTO_REFRESH_ON_RESEARCH=true
# A 'running' refresh row younger than this blocks a second refresh (other process).
# INSIGHTIQ_REFRESH_RUNNING_STALE_MINUTES=15
# Forecasts are invalidated by their input fingerprint; the TTL is only a safety net.
# INSIGHTIQ_FORECAST_CACHE_TTL_HOURS=720
# Company news older than this is not used as company-specific evidence.
# INSIGHTIQ_NEWS_MAX_AGE_DAYS=45
# Input-token budget of the news selection request (defaults to the Azure input budget).
# INSIGHTIQ_NEWS_REQUEST_TOKEN_BUDGET=24000

# ---- Market data providers and freshness ----
# INSIGHTIQ_MARKET_QUOTE_CACHE_HOURS=24
# INSIGHTIQ_MARKET_STATEMENT_CACHE_HOURS=168
# INSIGHTIQ_FINNHUB_REQUESTS_PER_MINUTE=50
# INSIGHTIQ_FMP_REQUESTS_PER_MINUTE=30
# INSIGHTIQ_FMP_DAILY_REQUEST_BUDGET=240
# INSIGHTIQ_YFINANCE_REQUESTS_PER_MINUTE=30
# INSIGHTIQ_SECTOR_REFRESH_MAX_COMPANIES=8
# "Compare selected companies": allowed number of companies (2..20, min <= max).
# INSIGHTIQ_CUSTOM_COMPARISON_MIN_COMPANIES=2
# INSIGHTIQ_CUSTOM_COMPARISON_MAX_COMPANIES=6

# ---- Database Configuration (PostgreSQL) ----
# Any PostgreSQL-compatible server. Either set DATABASE_URL (common on cloud hosts;
# it overrides the DB_* values), or the separate values below.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=company_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# disable | allow | prefer | require | verify-ca | verify-full (use require or stricter for remote servers)
DB_SSLMODE=prefer
# DB_SSLROOTCERT=C:\path\to\server-ca.pem    # with verify-ca / verify-full
# Optional tuning (defaults shown). Pool size is per application instance.
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_STATEMENT_TIMEOUT_MS=60000
# DB_SCHEMA=public
# Rollback only: DB_BACKEND=sqlite uses the original SQLite file instead.
# DB_BACKEND=postgres

# ---- Company Cache Configuration ----
# Company data (and provider search results) are cached in the database and
# expire exactly this many hours after the last successful fetch; repeat
# searches within that time make no provider or AI calls.
CACHE_TTL_HOURS=24
# Expired cache rows are deleted this often (minutes).
CACHE_CLEANUP_INTERVAL_MINUTES=5
# Minimum seconds between two manual "Refresh data" clicks for the same company.
# INSIGHTIQ_FORCE_REFRESH_COOLDOWN_SECONDS=60

# ---- Database: cloud connection hardening (optional) ----
# A non-local DB_HOST must use DB_SSLMODE=require or stricter (verify-full recommended,
# with DB_SSLROOTCERT=<CA file> or "system" for the OS trust store).
# DB_POOL_MAX_LIFETIME_SECONDS=1800
# DB_POOL_MAX_IDLE_SECONDS=300
# DB_ALLOW_INSECURE_REMOTE=false

# ---- Backups (scripts\backup_postgres.py; schedule with scripts\register_backup_task.ps1) ----
# BACKUP_DIR=data\pg_backups
# BACKUP_RETENTION_COUNT=14
# BACKUP_RETENTION_DAYS=30
# PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin

# ---- API hardening ----
# RATE_LIMIT_PER_MINUTE=240              # per client, per API process
# RATE_LIMIT_EXPENSIVE_PER_MINUTE=20     # provider/AI actions (research, refresh, summaries, comparisons)
# TRUSTED_PROXY_IPS=127.0.0.1            # only these may set X-Forwarded-For/-Proto
# INSIGHTIQ_API_HOST=127.0.0.1
# SSL_CERTFILE= / SSL_KEYFILE=           # serve HTTPS directly (otherwise terminate TLS at a proxy/ingress)
# FORCE_HTTPS=false                      # redirect plain HTTP to HTTPS (behind a trusted proxy)

# ---- Observability and maintenance ----
# TELEMETRY_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=365
# ALERT_API_P95_MS=2000
# ALERT_BACKUP_MAX_AGE_HOURS=26
