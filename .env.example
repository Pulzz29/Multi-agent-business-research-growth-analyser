# InsightIQ local configuration. Copy to .env and fill in. Never commit .env.
# Bearer key the dashboard uses to call the API (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
API_ACCESS_KEY=
# Groq API key (research agents)
GROQ_API_KEY=
# NewsData.io API key (news refresh)
NEWSDATA_API_KEY=
# SEC EDGAR identity: application name and contact email, e.g. "InsightIQ research you@example.com"
SEC_USER_AGENT=
# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# INSIGHTIQ_API_PORT=8000
# INSIGHTIQ_PROJECT_ROOT is set automatically by scripts/run_backend.py

# Optional: total token budget per News Agent Groq request (input + 1200 completion). Default 6000.
# INSIGHTIQ_NEWS_REQUEST_TOKEN_BUDGET=6000

# ---- Source freshness and refresh policy (optional) ----
# Stored evidence older than these limits is "stale". Start Research refreshes
# stale sources first unless disabled (the dashboard can also skip per run).
# INSIGHTIQ_SEC_CACHE_HOURS=24
# INSIGHTIQ_NEWS_CACHE_HOURS=6
# INSIGHTIQ_AUTO_REFRESH_ON_RESEARCH=true
# A 'running' refresh row younger than this blocks a second refresh (other process).
# INSIGHTIQ_REFRESH_RUNNING_STALE_MINUTES=15
# Forecasts are invalidated by their input fingerprint; the TTL is only a safety net.
# INSIGHTIQ_FORECAST_CACHE_TTL_HOURS=720

# ---- Groq research-writing budgets (optional) ----
# Estimated tokens (input + max completion) per request; 7000 stays under an
# 8,000 tokens-per-minute account limit because the estimator over-counts.
# INSIGHTIQ_GROQ_REQUEST_TOKEN_BUDGET=7000
# INSIGHTIQ_GROQ_FINANCIAL_MAX_COMPLETION=2800
# INSIGHTIQ_GROQ_NEWS_ANALYSIS_MAX_COMPLETION=2400
# INSIGHTIQ_GROQ_STRATEGIC_MAX_COMPLETION=2800
# gpt-oss reasoning tokens count against max completion: low | medium | high | (empty = provider default)
# INSIGHTIQ_GROQ_REASONING_EFFORT=low
# INSIGHTIQ_GROQ_REQUEST_TIMEOUT_SECONDS=45
# Executive summary request budget (input + 2000 completion). Default 8000.
# INSIGHTIQ_SUMMARY_REQUEST_TOKEN_BUDGET=8000

# ---- Market data providers (Markets and Sector-wise Comparison) ----
# US market: Finnhub (quotes, metrics, company news) and Financial Modeling Prep
# (company profile, financial statements). Indian market: Yahoo Finance via
# yfinance (no key) plus NewsData.io above. Keys stay on the backend only.
FINNHUB_API_KEY=
FMP_API_KEY=
# Optional limits and freshness policy
# INSIGHTIQ_MARKET_QUOTE_CACHE_HOURS=24
# INSIGHTIQ_MARKET_STATEMENT_CACHE_HOURS=168
# INSIGHTIQ_FINNHUB_REQUESTS_PER_MINUTE=50
# INSIGHTIQ_FMP_REQUESTS_PER_MINUTE=30
# INSIGHTIQ_FMP_DAILY_REQUEST_BUDGET=240
# INSIGHTIQ_YFINANCE_REQUESTS_PER_MINUTE=30
# INSIGHTIQ_SECTOR_REFRESH_MAX_COMPANIES=8

# ---- Company page data freshness ----
# Opening a company refreshes its provider data automatically when it was never
# refreshed or is older than this many hours (strictly greater). Fractions are
# allowed, e.g. 0.0167 = about 1 minute for testing.
# DATA_REFRESH_TTL_HOURS=6
# Minimum seconds between two manual "Refresh data" clicks for the same company.
# INSIGHTIQ_FORCE_REFRESH_COOLDOWN_SECONDS=60
